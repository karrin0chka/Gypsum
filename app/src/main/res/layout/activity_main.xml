<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <RelativeLayout
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorPrimary"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp">

        <TextView
            android:id="@+id/componentCalculator"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@color/colorBackground"
            android:text="@string/componentCalculator"
            android:textAlignment="center"
            android:textColor="@color/colorMain"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/volumeHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/componentCalculator"
            android:layout_marginHorizontal="20sp"
            android:layout_marginTop="5sp"
            android:text="@string/volumeHeadline"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/volumeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/volumeHeadline"
            android:layout_marginHorizontal="20sp"
            android:layout_marginTop="5sp"
            android:backgroundTint="@color/colorMain"
            android:ems="10"
            android:hint="@string/volumeInput"
            android:inputType="text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/proportionsHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/volumeInput"
            android:layout_marginHorizontal="20sp"
            android:layout_marginTop="10sp"
            android:text="@string/proportionsHeadline"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/gypsumHeadlineInput"
            android:layout_width="80sp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/proportionsHeadline"
            android:layout_marginStart="40sp"
            android:layout_marginTop="15sp"
            android:text="@string/gypsumHeadline"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/gypsumInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/proportionsHeadline"
            android:layout_alignParentStart="true"
            android:layout_marginStart="130sp"
            android:layout_marginEnd="20sp"
            android:layout_marginTop="5sp"
            android:hint="@string/gypsumInput"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/waterHeadlineInput"
            android:layout_width="80sp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/gypsumHeadlineInput"
            android:layout_marginStart="40sp"
            android:layout_marginTop="15sp"
            android:text="@string/waterHeadline"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/waterInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/gypsumHeadlineInput"
            android:layout_alignParentStart="true"
            android:layout_marginStart="130sp"
            android:layout_marginEnd="20sp"
            android:layout_marginTop="5sp"
            android:hint="@string/waterInput"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/svvHeadlineInput"
            android:layout_width="80sp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/waterHeadlineInput"
            android:layout_marginHorizontal="40sp"
            android:layout_marginTop="15sp"
            android:text="@string/svvHeadline"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/svvInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/waterHeadlineInput"
            android:layout_alignParentStart="true"
            android:layout_marginStart="130sp"
            android:layout_marginEnd="20sp"
            android:layout_marginTop="5sp"
            android:hint="@string/svvInput"
            android:textSize="20sp" />


        <Button
            android:id="@+id/clearButton"
            android:layout_width="155sp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/svvHeadlineInput"
            android:layout_alignParentStart="true"
            android:layout_marginStart="20sp"
            android:layout_marginTop="20sp"
            android:backgroundTint="@color/colorClearButton"
            android:text="@string/clearButton"
            android:textSize="19sp" />

        <Button
            android:id="@+id/calculatorButton"
            android:layout_width="155sp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/svvHeadlineInput"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="20sp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/colorMain"
            android:text="@string/calculatorButton"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/componentsOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/clearButton"
            android:layout_marginHorizontal="20sp"
            android:layout_marginTop="20sp"
            android:text="@string/componentsOutput"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/gypsumHeadline"
            android:layout_width="80sp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/componentsOutput"
            android:layout_marginStart="40sp"
            android:layout_marginTop="15sp"
            android:text="@string/gypsumHeadline"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/gypsumOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/componentsOutput"
            android:layout_alignParentStart="true"
            android:layout_marginStart="130sp"
            android:layout_marginEnd="20sp"
            android:layout_marginTop="15sp"
            android:hint="@string/gypsumOutput"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/waterHeadline"
            android:layout_width="80sp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/gypsumOutput"
            android:layout_marginStart="40sp"
            android:layout_marginTop="15sp"
            android:text="@string/waterHeadline"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/waterOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/gypsumOutput"
            android:layout_alignParentStart="true"
            android:layout_marginStart="130sp"
            android:layout_marginEnd="20sp"
            android:layout_marginTop="15sp"
            android:hint="@string/waterOutput"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/svvHeadline"
            android:layout_width="80sp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/waterOutput"
            android:layout_marginHorizontal="40sp"
            android:layout_marginTop="15sp"
            android:text="@string/svvHeadline"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/svvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/waterOutput"
            android:layout_alignParentStart="true"
            android:layout_marginStart="130sp"
            android:layout_marginEnd="20sp"
            android:layout_marginTop="15sp"
            android:hint="@string/svvOutput"
            android:textSize="20sp" />

        <Button
            android:id="@+id/returnMainButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/colorClearButton"
            android:text="@string/returnMainButton"
            android:textSize="19sp" />

    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>